# Example only. Do NOT put real keys in this file.
# Copy to .env and fill in a real key locally (.env is gitignored).

# LLM provider = Siraya model router (OpenAI-compatible), for cost optimization.
LLM_PROVIDER=siraya
SIRAYA_API_KEY=your_fake_key_here
SIRAYA_BASE_URL=https://llm.siraya.ai/v1

# Role-based model tiering (Siraya offers ~90 models; all below verified to support
# json_schema structured output). Cheap models for routing/reranking; a stronger
# model for the eligibility determination.
SIRAYA_ROUTER_MODEL=gemini-2.5-flash-lite      # request-type classification
SIRAYA_RERANK_MODEL=gemini-2.5-flash-lite      # LLM-as-reranker relevance scoring
SIRAYA_DRAFT_MODEL=gemini-2.5-flash            # free-text drafting of the HR response
SIRAYA_REASONING_MODEL=claude-sonnet-4.5       # eligibility determination + grounded answer
SIRAYA_CHAT_MODEL=gemini-2.5-flash             # default/fallback

# NOTE: Siraya has no embeddings endpoint and no rerank vendor on this account.
# Retrieval is rerank-free: keyword prefilter -> LLM-as-reranker -> cite-or-abstain.
# The `cost` response field is null; use returned token `usage` for the cost metric.
